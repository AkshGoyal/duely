{
  "name": "duely",
  "version": "0.1.0",
  "private": true,
  "description": "Duely: your own Claude chases overdue invoices; Duely keeps every payment link live and every client promise on record.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "connect-url": "node dist/scripts/connect-url.js",
    "connect-url:dev": "tsx src/scripts/connect-url.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "nanoid": "^3.3.20",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
